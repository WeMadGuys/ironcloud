# Supabase — Get from: Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Auth Provider: mock | twilio | firebase
# Use 'mock' for development (OTP is always 123456, no SMS sent)
# Use 'twilio' for production with real SMS
EXPO_PUBLIC_AUTH_PROVIDER=mock

# For Next.js web app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_AUTH_PROVIDER=mock

# Server-only (never expose to client) — for API routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio (only needed when AUTH_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SID=your-twilio-verify-service-sid

# Supabase CLI (for type generation)
SUPABASE_PROJECT_ID=your-project-id
