# Supabase — Get from: Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Auth Provider: mock | msg91
# Use 'mock' for development (OTP is always 1234, same 4-digit length as MSG91)
# Use 'msg91' for real SMS OTP via MSG91 (customer + rider apps)
EXPO_PUBLIC_AUTH_PROVIDER=mock

# Next.js API base URL (apps/web runs on port 3001)
# On a physical device, use your machine LAN IP, e.g. http://192.168.1.10:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# MSG91 OTP Widget (public — used by customer-app and rider-app)
EXPO_PUBLIC_MSG91_WIDGET_ID=your-msg91-widget-id
EXPO_PUBLIC_MSG91_TOKEN_AUTH=your-msg91-token-auth

# MSG91 account authkey (server-only — never expose to client)
# Used by /api/auth/msg91-session and /api/auth/msg91-session-rider
MSG91_AUTHKEY=your-msg91-authkey

# For Next.js admin web app (Google OAuth — not phone OTP)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Allowlist admin Gmails in public.admin_allowed_emails (migration 004)

# Server-only (never expose to client) — for API routes + admin allowlist checks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (wallet top-up — server only except Key ID)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Optional — for payment.captured webhook backup
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Public Key ID for customer app Razorpay checkout (same as RAZORPAY_KEY_ID in test/live)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx

# Supabase CLI (for type generation)
SUPABASE_PROJECT_ID=your-project-id
