{
  "name": "ironcloud",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "start": "npm run start --workspace=@ironcloud/customer-app",
    "start:tunnel": "npm run start:tunnel --workspace=@ironcloud/customer-app",
    "android": "npm run android --workspace=@ironcloud/customer-app",
    "ios": "npm run ios --workspace=@ironcloud/customer-app",
    "web": "npm run web --workspace=@ironcloud/customer-app",
    "customer:start": "npm run start --workspace=@ironcloud/customer-app",
    "customer:start:clear": "npm run start:clear --workspace=@ironcloud/customer-app",
    "customer:start:tunnel": "npm run start:tunnel --workspace=@ironcloud/customer-app",
    "rider:start": "npm run start --workspace=@ironcloud/rider-app",
    "rider:start:clear": "npm run start:clear --workspace=@ironcloud/rider-app",
    "rider:start:8082": "npm run start:8082:clear --workspace=@ironcloud/rider-app",
    "rider:start:tunnel": "npm run start:tunnel --workspace=@ironcloud/rider-app",
    "web:dev": "npm run dev --workspace=@ironcloud/web"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
