{
  "expo": {
    "name": "IronCloud Rider",
    "slug": "ironcloud-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ironcloud-rider",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.ironcloud.rider",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Iron Cloud Rider needs camera access to scan box QR codes at pickup and delivery."
      }
    },
    "android": {
      "package": "com.ironcloud.rider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Iron Cloud Rider to scan box QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6a3c413-4e1c-474f-aafb-eec455ae5c53"
      }
    }
  }
}
