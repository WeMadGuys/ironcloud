# Client-only env for Expo (loaded from this app directory).
# Keep MSG91_AUTHKEY and SUPABASE_SERVICE_ROLE_KEY in the repo root .env only.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# mock works in Expo Go (__DEV__ only). Release/EAS builds always force msg91.
EXPO_PUBLIC_AUTH_PROVIDER=msg91
# Phone: use Cloudflare tunnel to web:dev, or PC LAN IP — not localhost.
# Store / TestFlight builds should use https://ironcloud-rho.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:3001

EXPO_PUBLIC_MSG91_WIDGET_ID=
EXPO_PUBLIC_MSG91_TOKEN_AUTH=
