{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@ironcloud/api": [
        "../../packages/api/src/index.ts"
      ],
      "@ironcloud/api/*": [
        "../../packages/api/src/*"
      ],
      "@ironcloud/db": [
        "../../packages/db/src/index.ts"
      ],
      "@ironcloud/db/*": [
        "../../packages/db/src/*"
      ],
      "@ironcloud/ui": [
        "../../packages/ui/src/tokens/index.ts"
      ],
      "@ironcloud/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@ironcloud/config/legal": [
        "../../packages/config/src/legal.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
