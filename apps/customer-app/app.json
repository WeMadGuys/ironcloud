{
  "expo": {
    "name": "IronCloud",
    "slug": "ironcloud",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ironcloud",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ironcloud.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ironcloud.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow IronCloud to access your photos to set a profile picture.",
          "cameraPermission": "Allow IronCloud to use your camera to take a profile picture."
        }
      ]
    ]
  }
}
