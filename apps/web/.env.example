# Supabase credentials — copy from Dashboard → Settings → API
# You can put these in the repo root .env (shared with Expo apps) or here in .env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for allowlist checks, profile promote, and tRPC admin writes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — protects /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=generate-a-long-random-string

# Admin web uses Google OAuth (Supabase Auth → Google provider).
# Allowlist emails in public.admin_allowed_emails (see migration 004).
# Redirect allow list must include:
#   http://localhost:3001/admin/auth/callback
#   https://<your-vercel-domain>/admin/auth/callback

# MSG91 (customer + rider mobile app session routes — never expose to the client)
MSG91_AUTHKEY=your-msg91-authkey

# Razorpay (wallet top-up)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Optional — webhook backup at /api/payments/razorpay/webhook
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Dev only — Expo Go wallet top-up bypass against local web:dev.
# Hard-blocked when NODE_ENV/VERCEL_ENV is production — never set true on Vercel Production.
ALLOW_DEV_WALLET_TOPUP=true

# If you only have Expo vars in root .env, Next.js loads EXPO_PUBLIC_* automatically
# (see next.config.ts). You do not need to duplicate them unless you prefer NEXT_PUBLIC_*.
#
# Rider activation: new riders are is_active=false until an admin activates them
# in /admin/riders. Inactive riders can OTP-login but cannot use the app.
