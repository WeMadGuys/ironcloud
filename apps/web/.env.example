# Supabase credentials — copy from Dashboard → Settings → API
# You can put these in the repo root .env (shared with Expo apps) or here in .env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for allowlist checks, profile promote, and tRPC admin writes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — used for absolute URLs in server rendering
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# Admin web uses Google OAuth (Supabase Auth → Google provider).
# Allowlist emails in public.admin_allowed_emails (see migration 004).
# Redirect allow list must include:
#   http://localhost:3001/admin/auth/callback
#   https://<your-vercel-domain>/admin/auth/callback

# MSG91 (customer mobile app session route only — never expose to the client)
MSG91_AUTHKEY=your-msg91-authkey

# If you only have Expo vars in root .env, Next.js loads EXPO_PUBLIC_* automatically
# (see next.config.ts). You do not need to duplicate them unless you prefer NEXT_PUBLIC_*.
